{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/estimation/", "destination": "/simulateur/", "permanent": true },
    { "source": "/transmission/", "destination": "/entrepreneurs/", "permanent": true },
    { "source": "/croissance-externe/", "destination": "/entrepreneurs/", "permanent": true },
    { "source": "/litiges-entre-associes/", "destination": "/entrepreneurs/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
