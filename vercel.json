{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/transmission", "destination": "/entrepreneurs", "permanent": true },
    { "source": "/croissance-externe", "destination": "/entrepreneurs", "permanent": true },
    { "source": "/litiges-entre-associes", "destination": "/entrepreneurs", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
